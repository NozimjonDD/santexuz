[Unit]
Description=@@APP_NAME@@ database and private files backup
After=postgresql.service
ConditionPathExists=@@APP_ROOT@@/current/deploy/ubuntu/deploy.py

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 @@APP_ROOT@@/current/deploy/ubuntu/deploy.py --config @@CONFIG_PATH@@ backup
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=3600
StandardOutput=journal
StandardError=journal
