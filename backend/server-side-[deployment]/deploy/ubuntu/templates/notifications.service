[Unit]
Description=@@APP_NAME@@ transactional Telegram outbox
After=network-online.target postgresql.service
Wants=network-online.target
ConditionPathExists=@@APP_ROOT@@/current/manage.py
ConditionPathExists=!@@APP_ROOT@@/shared/maintenance.flag

[Service]
Type=oneshot
User=@@APP_USER@@
Group=@@APP_USER@@
WorkingDirectory=@@APP_ROOT@@/current
EnvironmentFile=/etc/@@APP_NAME@@/production.env
Environment=PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
ExecStart=@@APP_ROOT@@/current/.venv/bin/python manage.py deliver_notifications --limit 100
TimeoutStartSec=1800
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=@@APP_ROOT@@/shared
StandardOutput=journal
StandardError=journal
