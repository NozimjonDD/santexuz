# Generated by bootstrap at /etc/@@APP_NAME@@/production.env (root:app, 0640).
# Plain KEY=value, no quotes, spaces around '=' or shell expansion.
DJANGO_SETTINGS_MODULE=project_backend.settings.production
DEV_LOCAL_LOGIN=false
SECRET_KEY=@@SECRET_KEY@@
ALLOWED_HOSTS=@@DOMAIN@@
DB_ENGINE=postgresql
DB_NAME=@@APP_NAME@@
DB_USER=@@APP_NAME@@_app
DB_PASSWORD=@@DB_PASSWORD@@
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=prefer
MINI_APP_URL=https://@@DOMAIN@@/
CSRF_TRUSTED_ORIGINS=https://@@DOMAIN@@
CORS_ALLOWED_ORIGINS=
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_BOT_USERNAME=CHANGE_ME
TELEGRAM_WEBHOOK_SECRET=@@WEBHOOK_SECRET@@
TELEGRAM_INIT_DATA_MAX_AGE=300
ROUTING_BASE_URL=CHANGE_ME
ROUTING_API_KEY=
CONTRACT_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
MAX_ORDER_MEDIA_BYTES=20971520
MEDIA_ROOT=@@APP_ROOT@@/shared/private
STATIC_ROOT=@@APP_ROOT@@/shared/static
APP_LOG_PATH=@@APP_ROOT@@/shared/logs/app.log
DJANGO_LOG_LEVEL=INFO
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
